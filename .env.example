# Werewolf Activity — Discord Embedded App

# Discord Application
VITE_DISCORD_CLIENT_ID=1414397182890606665
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_PUBLIC_KEY=your_public_key_here

# OAuth2 redirect (must match Discord Developer Portal)
DISCORD_REDIRECT_URI=http://localhost:5173

# Game server
GAME_PORT=3001
CLIENT_PORT=5173

# Public URL (for Activity iframe). When using Cloudflare Tunnel, set this to your tunnel URL
PUBLIC_URL=https://your-tunnel-url.trycloudflare.com